# VisionGuard AI Server Environment Variables
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=visionguard_jwt_super_secret_safety_key_2026_x!98234
JWT_EXPIRES_IN=7d

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string (Used by migration runner scripts/runMigrations.js)
# Obtain from Supabase Project Settings -> Database -> Connection String (URI, pooling or direct)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API Key (Gemini Vision)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Uploads Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
